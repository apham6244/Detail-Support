# Detail Support — API server configuration.
# Copy to .env and fill in. Only SUPABASE_URL and SUPABASE_ANON_KEY are
# required: with nothing else set the app runs fully, logs notifications to the
# console instead of sending them, and leaves billing switched off.

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (your frontend dev + prod URLs)
CORS_ORIGINS=http://localhost:5173
# Public app URL — used for unsubscribe links and Stripe return URLs.
APP_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────────────────
# Project settings → API.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# "anon" public key. Every user request rides this plus the caller's JWT, so
# Row-Level Security stays the security boundary.
SUPABASE_ANON_KEY=your-anon-key
# "service_role" key — SERVER ONLY, never expose to the browser. Bypasses RLS.
# Needed by exactly two things, both of which have no user session to scope:
#   • the reminder scheduler (runs on a timer)
#   • the Stripe webhook (Stripe is not a signed-in user)
# Leave blank and both stay off; every other feature keeps working.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (migrations only) ───────────────────────────────────────────
# A direct Postgres connection string, used ONLY by the migration runner
# (`npm run db:migrate`) — the app itself never uses this. Get it from
# Supabase → Project Settings → Database → Connection string → "URI", and pick
# "Direct connection" or "Session pooler" (NOT "Transaction pooler", which
# can't run multi-statement migration transactions). Leave blank if you apply
# migrations by hand in the SQL editor instead.
DATABASE_URL=

# ── Email ────────────────────────────────────────────────────────────────
# "console" renders and logs the message instead of sending it, so invitations,
# reminders and campaigns work end to end with no provider account.
EMAIL_PROVIDER=console
EMAIL_FROM=hello@detailsupport.app
EMAIL_FROM_NAME=Detail Support
# Required only when EMAIL_PROVIDER=sendgrid:
SENDGRID_API_KEY=

# ── SMS ──────────────────────────────────────────────────────────────────
# Same shape as email: "console" logs the text instead of sending it.
SMS_PROVIDER=console
# Required only when SMS_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Stripe ───────────────────────────────────────────────────────────────
# Leave blank to run with billing off: the Billing page keeps the manual plan
# switcher, and the database permits it precisely because no Price ID is set.
#
# To turn billing ON, three things must line up:
#   1. STRIPE_SECRET_KEY below (use sk_test_… while developing; the server
#      refuses a sk_live_ key unless NODE_ENV=production).
#   2. STRIPE_WEBHOOK_SECRET below. The server REFUSES TO START with a secret
#      key but no webhook secret — that combination charges cards and never
#      activates the plan.
#   3. A Stripe Price ID on each paid tier in the database:
#        update public.plans set stripe_price_id='price_…' where plan='pro';
#        update public.plans set stripe_price_id='price_…' where plan='team';
#      This is the switch: the moment a paid tier has a Price ID,
#      billing_is_live() flips true and the database stops honouring the free
#      plan switcher, so nobody can self-grant a paid plan.
#
#   Founding members: set stripe_price_id_founding to a Stripe Price at their
#   locked rate. Without it they'd be charged list price, quietly breaking the
#   locked-in-pricing promise made at signup.
#
# Local webhook testing (Stripe CLI):
#   stripe listen --forward-to localhost:4000/api/billing/webhook
#   → prints the whsec_… to paste below
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI (Anthropic) ───────────────────────────────────────────────────────
# Powers the Detailer Gear Assistant (the "Ask the AI" tab on the Gear Guide).
# Optional: without it the assistant route reports "not configured" and the UI
# hides the feature. The key is SERVER-ONLY — it never reaches the browser.
# Get one at https://console.anthropic.com. Note: assistant calls cost tokens
# (model: claude-opus-4-8), so the route is rate-limited to 30 / 15 min per IP.
ANTHROPIC_API_KEY=
